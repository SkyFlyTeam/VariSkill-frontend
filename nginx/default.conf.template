# Rendered by the nginx image entrypoint (envsubst): only ${API_UPSTREAM} and
# ${NGINX_RESOLVER} are replaced; nginx's own $variables are left untouched.
# This file is included inside the http {} block of the stock nginx.conf.

server_tokens off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/javascript application/javascript
           application/json application/vnd.oai.openapi image/svg+xml;

# Brute-force protection for the auth endpoints, per client IP.
limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
limit_req_status 429;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 10m;

    # Docker's embedded DNS. Resolving at request time (instead of at startup)
    # lets nginx boot before the backend and follow it across restarts.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $django_upstream ${API_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Django ------------------------------------------------------------

    location ~ ^/api/(login|register)/$ {
        limit_req zone=auth burst=20 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $django_upstream;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $django_upstream;
    }

    location /admin/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $django_upstream;
    }

    # Django collectstatic output, from the volume shared with the backend.
    location /static/ {
        alias /usr/share/nginx/django-static/;
        expires 7d;
        access_log off;
    }

    # JSON errors so the SPA's ApiError handling can show a message.
    location @backend_unavailable {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        return 503 '{"detail":"Serviço temporariamente indisponível. Tente novamente em instantes."}';
    }

    location @too_many_requests {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After "60" always;
        return 429 '{"detail":"Muitas tentativas. Aguarde um minuto e tente novamente."}';
    }

    # ---- SPA ---------------------------------------------------------------

    # Hashed Vite bundles never change for a given name.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # Always revalidate the entrypoint so new deploys are picked up at once.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Client-side routes (react-router) fall back to the SPA entrypoint.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
