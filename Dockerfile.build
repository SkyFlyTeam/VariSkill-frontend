# Builds the Vite bundle and serves it with nginx, which also proxies /api to
# the Django backend and serves Django's collected static files.

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM nginx:1.29-alpine AS runtime

# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
ENV API_UPSTREAM=http://backend:8000 \
    NGINX_RESOLVER=127.0.0.11

COPY nginx/snippets/ /etc/nginx/snippets/
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
